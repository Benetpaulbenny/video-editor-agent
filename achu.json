{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "achu.json",
  "title": "Porotta Frame Analysis Record",
  "description": "Machine-readable schema for one parsed frame-analysis row.",
  "type": "object",
  "required": [
    "frame_number",
    "image_quality",
    "color_analysis",
    "face_detection",
    "face_landmark",
    "head_pose",
    "pose_estimation",
    "object_detection",
    "segmentation",
    "ocr",
    "scene_classification"
  ],
  "properties": {
    "frame_number": {
      "description": "[serial number, exact frame number, timestamp in seconds]",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 },
        { "type": "number", "minimum": 0 }
      ],
      "minItems": 3,
      "maxItems": 3,
      "type": "array"
    },
    "image_quality": {
      "description": "[mean brightness, global contrast, blur score, noise score]",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 255 },
        { "type": "number", "minimum": 0 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "minItems": 4,
      "maxItems": 4,
      "type": "array"
    },
    "color_analysis": {
      "description": "[color temperature, dominant colors, average RGB, saturation]",
      "prefixItems": [
        {
          "description": "[Kelvin, classification]",
          "prefixItems": [
            { "type": "integer", "minimum": 1000, "maximum": 12000 },
            { "enum": ["cool", "neutral", "warm"] }
          ],
          "minItems": 2,
          "maxItems": 2,
          "type": "array"
        },
        {
          "description": "[[r, g, b, percentage], ...]",
          "items": {
            "prefixItems": [
              { "type": "integer", "minimum": 0, "maximum": 255 },
              { "type": "integer", "minimum": 0, "maximum": 255 },
              { "type": "integer", "minimum": 0, "maximum": 255 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "minItems": 4,
            "maxItems": 4,
            "type": "array"
          },
          "type": "array"
        },
        {
          "description": "[red, green, blue]",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 255 },
            { "type": "number", "minimum": 0, "maximum": 255 },
            { "type": "number", "minimum": 0, "maximum": 255 }
          ],
          "minItems": 3,
          "maxItems": 3,
          "type": "array"
        },
        {
          "description": "[mean, median, low saturation ratio, high saturation ratio]",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "minItems": 4,
          "maxItems": 4,
          "type": "array"
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "type": "array"
    },
    "face_detection": {
      "description": "[[face id, bounding box, confidence, embedding vector], ...]",
      "items": {
        "prefixItems": [
          { "type": "string" },
          {
            "description": "[x1, y1, x2, y2]",
            "prefixItems": [
              { "type": "number" },
              { "type": "number" },
              { "type": "number" },
              { "type": "number" }
            ],
            "minItems": 4,
            "maxItems": 4,
            "type": "array"
          },
          { "type": "number", "minimum": 0, "maximum": 1 },
          {
            "description": "ArcFace embedding vector",
            "items": { "type": "number" },
            "type": "array"
          }
        ],
        "minItems": 4,
        "maxItems": 4,
        "type": "array"
      },
      "type": "array"
    },
    "face_landmark": {
      "description": "[[face id, [eyes, nose, jaw, mouth], [normalized eyes, nose, jaw, mouth], detector confidence], ...]",
      "items": {
        "prefixItems": [
          { "type": "string" },
          {
            "items": {
              "prefixItems": [
                { "type": "number" },
                { "type": "number" }
              ],
              "minItems": 2,
              "maxItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          {
            "items": {
              "prefixItems": [
                { "type": "number", "minimum": 0, "maximum": 1 },
                { "type": "number", "minimum": 0, "maximum": 1 }
              ],
              "minItems": 2,
              "maxItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          { "type": "number", "minimum": 0, "maximum": 1 }
        ],
        "minItems": 4,
        "maxItems": 4,
        "type": "array"
      },
      "type": "array"
    },
    "head_pose": {
      "description": "[[face id, yaw, pitch, roll, confidence], ...]",
      "items": {
        "prefixItems": [
          { "type": "string" },
          { "type": "number" },
          { "type": "number" },
          { "type": "number" },
          { "type": "number", "minimum": 0, "maximum": 1 }
        ],
        "minItems": 5,
        "maxItems": 5,
        "type": "array"
      },
      "type": "array"
    },
    "pose_estimation": {
      "description": "[[person id, confidence, 17 keypoints, hands, body orientation, movement], ...]",
      "items": {
        "prefixItems": [
          { "type": "string" },
          { "type": "number", "minimum": 0, "maximum": 1 },
          {
            "description": "17 keypoints in YOLO11 Pose order; each is [x, y, confidence]",
            "items": {
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number", "minimum": 0, "maximum": 1 }
              ],
              "minItems": 3,
              "maxItems": 3,
              "type": "array"
            },
            "minItems": 17,
            "maxItems": 17,
            "type": "array"
          },
          {
            "description": "[left wrist, right wrist]",
            "items": {
              "prefixItems": [
                { "type": "number" },
                { "type": "number" },
                { "type": "number", "minimum": 0, "maximum": 1 }
              ],
              "minItems": 3,
              "maxItems": 3,
              "type": "array"
            },
            "minItems": 2,
            "maxItems": 2,
            "type": "array"
          },
          {
            "description": "[rotation in degrees, direction]",
            "prefixItems": [
              { "type": "number" },
              { "enum": ["left", "right", "center", "unknown"] }
            ],
            "minItems": 2,
            "maxItems": 2,
            "type": "array"
          },
          {
            "description": "[moving, direction, speed in pixels per second]",
            "prefixItems": [
              { "type": "boolean" },
              { "enum": ["left", "right", "up", "down", "stationary"] },
              { "type": "number", "minimum": 0 }
            ],
            "minItems": 3,
            "maxItems": 3,
            "type": "array"
          }
        ],
        "minItems": 6,
        "maxItems": 6,
        "type": "array"
      },
      "type": "array"
    },
    "object_detection": {
      "description": "[[object id, class, bounding box, normalized bounding box, confidence, size], ...]",
      "items": {
        "prefixItems": [
          { "type": "string" },
          { "type": "string" },
          {
            "description": "[x1, y1, x2, y2] in pixels",
            "prefixItems": [
              { "type": "number" },
              { "type": "number" },
              { "type": "number" },
              { "type": "number" }
            ],
            "minItems": 4,
            "maxItems": 4,
            "type": "array"
          },
          {
            "description": "[x1, y1, x2, y2] normalized to frame dimensions",
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "minItems": 4,
            "maxItems": 4,
            "type": "array"
          },
          { "type": "number", "minimum": 0, "maximum": 1 },
          {
            "description": "[width, height, area ratio]",
            "prefixItems": [
              { "type": "number", "minimum": 0 },
              { "type": "number", "minimum": 0 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "minItems": 3,
            "maxItems": 3,
            "type": "array"
          }
        ],
        "minItems": 6,
        "maxItems": 6,
        "type": "array"
      },
      "type": "array"
    },
    "segmentation": {
      "type": "object",
      "required": [
        "persons",
        "foreground_mask",
        "background_mask",
        "sky_mask",
        "ground_mask"
      ],
      "properties": {
        "persons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["person_id", "mask_rle", "area_ratio"],
            "properties": {
              "person_id": { "type": "string" },
              "mask_rle": { "$ref": "#/$defs/mask_rle" },
              "area_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "foreground_mask": { "$ref": "#/$defs/mask_rle" },
        "background_mask": { "$ref": "#/$defs/mask_rle" },
        "sky_mask": { "$ref": "#/$defs/mask_rle" },
        "ground_mask": { "$ref": "#/$defs/mask_rle" }
      },
      "additionalProperties": false
    },
    "ocr": {
      "type": "object",
      "required": ["texts"],
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "polygon", "bbox", "confidence", "area_ratio"],
            "properties": {
              "text": { "type": "string" },
              "language": { "type": "string" },
              "polygon": {
                "type": "array",
                "items": {
                  "prefixItems": [
                    { "type": "number", "minimum": 0 },
                    { "type": "number", "minimum": 0 }
                  ],
                  "minItems": 2,
                  "maxItems": 2,
                  "type": "array"
                },
                "minItems": 3
              },
              "bbox": {
                "type": "object",
                "required": ["x1", "y1", "x2", "y2"],
                "properties": {
                  "x1": { "type": "number", "minimum": 0 },
                  "y1": { "type": "number", "minimum": 0 },
                  "x2": { "type": "number", "minimum": 0 },
                  "y2": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": false
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "area_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scene_classification": {
      "type": "object",
      "required": ["category", "top_class", "predictions"],
      "properties": {
        "category": { "enum": ["indoor", "outdoor"] },
        "top_class": {
          "type": "object",
          "required": ["label", "confidence"],
          "properties": {
            "label": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "predictions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["label", "confidence"],
            "properties": {
              "label": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "future_features": {
      "description": "Reserved CSV columns currently represented by 0.",
      "properties": {
        "camera_analysis": { "const": 0 }
      },
      "type": "object"
    }
  },
  "csv_columns": [
    "Frame_number[S.No, Frame number, Timestamp]",
    "Image_quality[Brightness, Contrast, Blur score, Noise]",
    "Color_analysis[Color temp[kelvin, classification], Dominant colors[r, g, b, percentage], Avg RGB[r, g, b], Saturation[mean, median, low_saturation_ratio, high_saturation_ratio]]",
    "Face detection[face_id, bbox[x1, y1, x2, y2], confidence, embedding[vector]]",
    "Face landmark[face_id, eyes[left, right], nose, jaw, mouth, normalized[eyes[left, right], nose, jaw, mouth], landmark_confidence[detector confidence]]",
    "Head pose[face_id, yaw, pitch, roll, confidence]",
    "Pose estimation[person_id, confidence, keypoints[17x[x, y, confidence]], hands[left[x, y, confidence], right[x, y, confidence]], body_orientation[rotation, direction], movement[moving, direction, speed]]",
    "Object detection[object_id, class, bbox[x1, y1, x2, y2], bbox_normalized[x1, y1, x2, y2], confidence, size[width, height, area_ratio]]",
    "Segmentation[persons[person_id, mask_rle[size[h, w], counts], area_ratio], foreground_mask[mask_rle[size[h, w], counts]], background_mask[mask_rle[size[h, w], counts]], sky_mask[mask_rle[size[h, w], counts]], ground_mask[mask_rle[size[h, w], counts]]]",
    "OCR[texts[text, language[optional], polygon[[x, y]], bbox[x1, y1, x2, y2], confidence, area_ratio]]",
    "Scene classification[category, top_class[label, confidence], predictions[label, confidence]]",
    "Camera analysis"
  ],
  "$defs": {
    "mask_rle": {
      "description": "Object containing original mask size and comma-separated column-major run lengths beginning with the background run.",
      "type": "object",
      "required": ["size", "counts"],
      "properties": {
        "size": {
          "prefixItems": [
            { "type": "integer", "minimum": 0 },
            { "type": "integer", "minimum": 0 }
          ],
          "minItems": 2,
          "maxItems": 2,
          "type": "array"
        },
        "counts": { "type": "string", "pattern": "^[0-9]+(?:,[0-9]+)*$" }
      },
      "additionalProperties": false
    }
  }
}
